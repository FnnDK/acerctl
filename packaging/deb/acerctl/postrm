#!/bin/sh
# purge also removes the remembered state (/var/lib/acerd), as purge does.
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
	systemd-hwdb update >/dev/null 2>&1 || true
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
	fi
fi
if [ "$1" = remove ] && [ -x /usr/bin/deb-systemd-helper ]; then
	deb-systemd-helper mask acerd.service >/dev/null || true
fi
if [ "$1" = purge ]; then
	if [ -x /usr/bin/deb-systemd-helper ]; then
		deb-systemd-helper purge acerd.service >/dev/null || true
		deb-systemd-helper unmask acerd.service >/dev/null || true
	fi
	rm -rf /var/lib/acerd
fi
