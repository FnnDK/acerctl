[Unit]
Description=acerd, Acer Nitro/Predator control daemon (io.github.fnndk.Acerd1)
Documentation=file:///usr/share/doc/acerctl/api-dbus.md
# Companion modules first; tuned/PPD before us so our profile is applied last.
After=acer-wmi-modules.service tuned.service power-profiles-daemon.service dbus.service
Wants=acer-wmi-modules.service

[Service]
Type=dbus
BusName=io.github.fnndk.Acerd1
ExecStart=/usr/local/bin/acerd
Restart=on-failure
StateDirectory=acerd
# Hardening (root is needed for sysfs writes, RAPL and evdev).
ProtectSystem=strict
ReadWritePaths=/sys
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
DeviceAllow=char-input r
# nvidia-smi / NVML need the NVIDIA character devices.
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidiactl rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-nvidia-caps r
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
